# 複製本檔為 .env，填入自己的值（.env 不會上傳到 GitHub）
# 部署到 GitHub 時，改在 repo 的 Settings → Secrets and variables → Actions 設定同名變數

# FRED API 金鑰：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Gmail 寄信（提醒信）：SMTP_PASSWORD 是 Gmail「應用程式密碼」，不是登入密碼
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 收件人（選填，多個用逗號分隔）；不填就寄給 SMTP_USER 自己
MAIL_TO=

# 儀表板網址改寫在 config.yaml 的 email.dashboard_url
